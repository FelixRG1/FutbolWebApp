Use DataDict.pkg
Open entrenador
Open equipo

Object oNacionalidad_VT is a CodeValidationTable
    Set Type_Value to "NACIONALIDAD"
End_Object

Class centrenadorDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to entrenador.File_Number

        Set Add_Server_File to equipo.File_Number

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to False 
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to False 
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to False 
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
        Set Key_Field_State Field entrenador.ID to True
        Set Field_Option Field entrenador.Nombre DD_REQUIRED to True
        Set Field_Option Field entrenador.Apellido DD_REQUIRED to True
        Set Field_Option Field entrenador.Nombre DD_NOENTER to True
        Set Field_Option Field entrenador.Apellido DD_NOENTER to True
        Set ParentNullAllowed equipo.File_Number to True  
        Set Field_Value_Table Field entrenador.Nacionalidad to oNacionalidad_VT

    End_Procedure
    
        Procedure Null_Parent Integer iFile
            Forward Send Null_Parent iFile
            If (iFile = equipo.File_Number) Begin
                Set_Attribute DF_FIELD_NULL_ALLOWED of entrenador.File_Number 5 to True
                Set_Field_Value entrenador.File_Number 5 to ""
            End
        End_Procedure


End_Class