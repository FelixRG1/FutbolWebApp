38916>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38919>>>        WebSet pbRender of oNewButton to True
38920>>>        WebSet pbRender of oDetailButton to True
38921>>>
38921>>>        Case Begin
38921>>>            Case (NavigateData.eNavigateType = nfFromParent)
38923>>>                // If from parent, this is a constrained drill down
38923>>>                // If Row select does main-zoom we don't need this
38923>>>                WebSet pbRender of oDetailButton to False
38924>>>                Case Break
38925>>>
38925>>>            Case (NavigateData.eNavigateType = nfFromChild)
38928>>>                // If from child, this is a probably a parent lookup from a Zoom
38928>>>                Case Break
38929>>>
38929>>>            Case (NavigateData.eNavigateType = nfFromMain)
38932>>>                // If from main, this is a probably a main-file lookup from a Zoom
38932>>>                WebSet pbRender of oDetailButton to False
38933>>>                Case Break
38934>>>
38934>>>            Case Else // must be nfUndefined
38934>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38934>>>                // If Row select does main-zoom we don't need this
38934>>>                WebSet pbRender of oDetailButton to False
38935>>>
38935>>>        Case End
38935>>>
38935>>>    End_Procedure
38936>>>
38936>>>
38936>>>End_Object 
