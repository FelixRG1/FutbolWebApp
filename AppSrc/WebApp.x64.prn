39058>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39061>>>        WebSet pbRender of oNewButton to True
39062>>>        WebSet pbRender of oDetailButton to True
39063>>>
39063>>>        Case Begin
39063>>>            Case (NavigateData.eNavigateType = nfFromParent)
39065>>>                // If from parent, this is a constrained drill down
39065>>>                // If Row select does main-zoom we don't need this
39065>>>                WebSet pbRender of oDetailButton to False
39066>>>                Case Break
39067>>>
39067>>>            Case (NavigateData.eNavigateType = nfFromChild)
39070>>>                // If from child, this is a probably a parent lookup from a Zoom
39070>>>                Case Break
39071>>>
39071>>>            Case (NavigateData.eNavigateType = nfFromMain)
39074>>>                // If from main, this is a probably a main-file lookup from a Zoom
39074>>>                WebSet pbRender of oDetailButton to False
39075>>>                Case Break
39076>>>
39076>>>            Case Else // must be nfUndefined
39076>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39076>>>                // If Row select does main-zoom we don't need this
39076>>>                WebSet pbRender of oDetailButton to False
39077>>>
39077>>>        Case End
39077>>>
39077>>>    End_Procedure
