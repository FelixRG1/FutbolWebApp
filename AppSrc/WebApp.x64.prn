39112>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39115>>>        WebSet pbRender of oNewButton to True
39116>>>        WebSet pbRender of oDetailButton to True
39117>>>
39117>>>        Case Begin
39117>>>            Case (NavigateData.eNavigateType = nfFromParent)
39119>>>                // If from parent, this is a constrained drill down
39119>>>                // If Row select does main-zoom we don't need this
39119>>>                WebSet pbRender of oDetailButton to False
39120>>>                Case Break
39121>>>
39121>>>            Case (NavigateData.eNavigateType = nfFromChild)
39124>>>                // If from child, this is a probably a parent lookup from a Zoom
39124>>>                Case Break
39125>>>
39125>>>            Case (NavigateData.eNavigateType = nfFromMain)
39128>>>                // If from main, this is a probably a main-file lookup from a Zoom
39128>>>                WebSet pbRender of oDetailButton to False
39129>>>                Case Break
39130>>>
39130>>>            Case Else // must be nfUndefined
39130>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39130>>>                // If Row select does main-zoom we don't need this
39130>>>                WebSet pbRender of oDetailButton to False
39131>>>
39131>>>        Case End
