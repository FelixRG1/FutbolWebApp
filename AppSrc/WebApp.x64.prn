38261>>>        // let's hide all buttons and then Show the ones we want
38261>>>        WebSet pbRender of oEditBtn to False
38262>>>        WebSet pbRender of oSaveBtn to False
38263>>>        WebSet pbRender of oCancelChangesBtn to False
38264>>>        WebSet pbRender of oDeleteBtn to False
38265>>>
38265>>>        If (NavigateData.bReadOnly) Begin
38267>>>            WebSet pbRender of oEditBtn to True
