38498>>>        WebSet pbRender of oNewButton to True
38499>>>        WebSet pbRender of oDetailButton to True
38500>>>
38500>>>        Case Begin
38500>>>            Case (NavigateData.eNavigateType = nfFromParent)
38502>>>                // If from parent, this is a constrained drill down
38502>>>                // If Row select does main-zoom we don't need this
38502>>>                WebSet pbRender of oDetailButton to False
38503>>>                Case Break
38504>>>
38504>>>            Case (NavigateData.eNavigateType = nfFromChild)
38507>>>                // If from child, this is a probably a parent lookup from a Zoom
38507>>>                Case Break
38508>>>
38508>>>            Case (NavigateData.eNavigateType = nfFromMain)
38511>>>                // If from main, this is a probably a main-file lookup from a Zoom
38511>>>                WebSet pbRender of oDetailButton to False
38512>>>                Case Break
38513>>>
38513>>>            Case Else // must be nfUndefined
38513>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38513>>>                // If Row select does main-zoom we don't need this
38513>>>                WebSet pbRender of oDetailButton to False
38514>>>
38514>>>        Case End
38514>>>
38514>>>    End_Procedure
