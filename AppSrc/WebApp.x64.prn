39006>>>                Case Break
39007>>>
39007>>>            Case (NavigateData.eNavigateType = nfFromChild)
39010>>>                // If from child, this is a probably a parent lookup from a Zoom
39010>>>                Case Break
39011>>>
39011>>>            Case (NavigateData.eNavigateType = nfFromMain)
39014>>>                // If from main, this is a probably a main-file lookup from a Zoom
39014>>>                WebSet pbRender of oDetailButton to False
39015>>>                Case Break
39016>>>
39016>>>            Case Else // must be nfUndefined
39016>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39016>>>                // If Row select does main-zoom we don't need this
39016>>>                WebSet pbRender of oDetailButton to False
39017>>>
39017>>>        Case End
