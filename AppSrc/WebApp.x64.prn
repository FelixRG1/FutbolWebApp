38821>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38824>>>        WebSet pbRender of oNewButton to True
38825>>>        WebSet pbRender of oDetailButton to True
38826>>>
38826>>>        Case Begin
38826>>>            Case (NavigateData.eNavigateType = nfFromParent)
38828>>>                // If from parent, this is a constrained drill down
38828>>>                // If Row select does main-zoom we don't need this
38828>>>                WebSet pbRender of oDetailButton to False
38829>>>                Case Break
38830>>>
38830>>>            Case (NavigateData.eNavigateType = nfFromChild)
38833>>>                // If from child, this is a probably a parent lookup from a Zoom
38833>>>                Case Break
38834>>>
38834>>>            Case (NavigateData.eNavigateType = nfFromMain)
38837>>>                // If from main, this is a probably a main-file lookup from a Zoom
38837>>>                WebSet pbRender of oDetailButton to False
38838>>>                Case Break
38839>>>
38839>>>            Case Else // must be nfUndefined
38839>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38839>>>                // If Row select does main-zoom we don't need this
38839>>>                WebSet pbRender of oDetailButton to False
38840>>>
38840>>>        Case End
38840>>>
38840>>>    End_Procedure
