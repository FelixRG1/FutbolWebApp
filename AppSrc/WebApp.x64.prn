38461>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38464>>>        WebSet pbRender of oNewButton to True
38465>>>        WebSet pbRender of oDetailButton to True
38466>>>
38466>>>        Case Begin
38466>>>            Case (NavigateData.eNavigateType = nfFromParent)
38468>>>                // If from parent, this is a constrained drill down
38468>>>                // If Row select does main-zoom we don't need this
38468>>>                WebSet pbRender of oDetailButton to False
38469>>>                Case Break
38470>>>
38470>>>            Case (NavigateData.eNavigateType = nfFromChild)
38473>>>                // If from child, this is a probably a parent lookup from a Zoom
38473>>>                Case Break
38474>>>
38474>>>            Case (NavigateData.eNavigateType = nfFromMain)
38477>>>                // If from main, this is a probably a main-file lookup from a Zoom
38477>>>                WebSet pbRender of oDetailButton to False
38478>>>                Case Break
38479>>>
38479>>>            Case Else // must be nfUndefined
38479>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38479>>>                // If Row select does main-zoom we don't need this
38479>>>                WebSet pbRender of oDetailButton to False
38480>>>
38480>>>        Case End
38480>>>
38480>>>    End_Procedure
38481>>>
38481>>>
38481>>>End_Object 
