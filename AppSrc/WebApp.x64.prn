38424>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38427>>>        WebSet pbRender of oNewButton to True
38428>>>        WebSet pbRender of oDetailButton to True
38429>>>
38429>>>        Case Begin
38429>>>            Case (NavigateData.eNavigateType = nfFromParent)
38431>>>                // If from parent, this is a constrained drill down
38431>>>                // If Row select does main-zoom we don't need this
38431>>>                WebSet pbRender of oDetailButton to False
38432>>>                Case Break
38433>>>
38433>>>            Case (NavigateData.eNavigateType = nfFromChild)
38436>>>                // If from child, this is a probably a parent lookup from a Zoom
38436>>>                Case Break
38437>>>
38437>>>            Case (NavigateData.eNavigateType = nfFromMain)
38440>>>                // If from main, this is a probably a main-file lookup from a Zoom
38440>>>                WebSet pbRender of oDetailButton to False
38441>>>                Case Break
38442>>>
38442>>>            Case Else // must be nfUndefined
38442>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38442>>>                // If Row select does main-zoom we don't need this
38442>>>                WebSet pbRender of oDetailButton to False
38443>>>
38443>>>        Case End
38443>>>
38443>>>    End_Procedure
38444>>>
38444>>>
38444>>>End_Object 
