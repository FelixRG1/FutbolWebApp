37568>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37571>>>        Case Begin
37571>>>            Case (NavigateData.eNavigateType = nfFromMain)
37573>>>                // If from main, this is a propbably a main file Select to Zoom.
37573>>>                Case Break
37574>>>
37574>>>            Case (NavigateData.eNavigateType = nfFromParent)
37577>>>                // If from parent, this is a constrained drill down.
37577>>>                Case Break
37578>>>
37578>>>            Case (NavigateData.eNavigateType = nfFromChild)
37581>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37581>>>                Case Break
37582>>>
37582>>>            Case Else // must be nfUndefined
37582>>>
37582>>>        Case End
37582>>>
37582>>>        Send SetActionButtons
37583>>>
37583>>>    End_Procedure
