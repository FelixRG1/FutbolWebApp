37881>>>    Procedure SetActionButtons
37884>>>        tWebNavigateData NavigateData
37884>>>        tWebNavigateData NavigateData
37884>>>        Boolean bHasRecord
37884>>>        Handle hoDD
37884>>>
37884>>>        Get Server to hoDD
37885>>>        Get GetNavigateData to NavigateData
37886>>>        Get HasRecord of hoDD to bHasRecord
37887>>>
37887>>>        // let's hide all buttons and then Show the ones we want
37887>>>        WebSet pbRender of oEditBtn to False
37888>>>        WebSet pbRender of oSaveBtn to False
37889>>>        WebSet pbRender of oCancelChangesBtn to False
37890>>>        WebSet pbRender of oDeleteBtn to False
37891>>>
37891>>>        If (NavigateData.bReadOnly) Begin
37893>>>            WebSet pbRender of oEditBtn to True
37894>>>        End
37894>>>>
37894>>>        Else Begin
37895>>>            WebSet pbRender of oSaveBtn to True
37896>>>            WebSet pbRender of oCancelChangesBtn to True
37897>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37898>>>        End
37898>>>>
37898>>>    End_Procedure
