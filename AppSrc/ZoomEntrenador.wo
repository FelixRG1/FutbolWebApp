// C:\Users\Usuario\Documents\DataFlex Projects\FutbolWebApp\AppSrc\ZoomEntrenador.wo
// ZoomEntrenador
//
Use sql.pkg
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use SelectEquipo.wo
Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use centrenadorDataDictionary.dd

Object oZoomEntrenador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "ZoomEntrenador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to False
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to False
        Set DDO_Server to oliga_DD
    End_Object 

    Object oentrenador_DD is a centrenadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To oentrenador_DD
    Set Server  To oentrenador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object oentrenadorNombre is a cWebForm
            Entry_Item entrenador.Nombre
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object oentrenadorApellido is a cWebForm
            Entry_Item entrenador.Apellido
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object 

        Object oentrenadorNacionalidad is a cWebForm
            Entry_Item entrenador.Nacionalidad
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
        End_Object 
       
    
         Object oEquipoNombre is a cWebForm
            Entry_Item Equipo.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set pbPromptButton to True
        
            WebRegisterPath ntNavigateForward oSelectEquipo
        
            Procedure OnPrompt
                Send NavigatePath
              End_Procedure
         End_Object
         
          Object oBtnDespedir is a cWebButton
            Set piColumnSpan to 4
            Set piColumnIndex to 4
            Set psCaption to "Despedir"

            Procedure OnClick
                Handle hoSQLMngr hdbc hstmt
                Integer iEntrenadorID iRet
            
                Get Field_Current_Value of oentrenador_DD Field entrenador.ID to iEntrenadorID
                If (iEntrenadorID > 0) Begin
                    Get Create (RefClass(cSQLHandleManager)) to hoSQLMngr
                    Get SQLFileConnect of hoSQLMngr entrenador.File_Number to hdbc
                    Get SQLOpen of hdbc to hstmt
                    Send SQLExecDirect of hstmt ("UPDATE entrenador SET EquipoID = NULL WHERE ID = " + String(iEntrenadorID))
                    Send SQLClose of hstmt
                    Send SQLDisconnect of hdbc
                    Send Destroy of hoSQLMngr
            
                    Send Clear of oequipo_DD
                    Send FindByRowId of oentrenador_DD entrenador.File_Number (GetRowId(entrenador.File_Number))
                    Send NavigateClose Self
                End
             End_Procedure
          End_Object 
         
    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Guardar"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Editar"
            Procedure OnClick
                Send ChangeEditMode True
                Send ChangeEditMode True
                WebSet pbEnabled of oentrenadorNombre to False
                WebSet pbEnabled of oentrenadorApellido to False
                WebSet pbEnabled of oEquipoNombre to True
                Send SetActionButtons
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Borrar"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Eliminar Cambios"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject
    
        If (HasRecord(Server(Self))) Begin
            WebSet psCaption to ("Entrenador: " + Trim(Entrenador.Nombre))
            Send SetHeaderCaption ("Entrenador: " + Trim(Entrenador.Nombre))
            Send SetBreadCrumbCaption (Trim(Entrenador.Nombre))
            
            WebSet pbEnabled of oentrenadorNombre to False
            WebSet pbEnabled of oentrenadorApellido to False
            WebSet pbEnabled of oEquipoNombre to False
            WebSet pbEnabled of oBtnDespedir to (Equipo.ID <> 0)
        End
        Else Begin
            WebSet psCaption to "Nuevo Entrenador"
            Send SetHeaderCaption "Nuevo Entrenador"
            Send SetBreadCrumbCaption "Nuevo"

            WebSet pbEnabled of oEntrenadorNombre to True
            WebSet pbEnabled of oEntrenadorApellido to True
            WebSet pbEnabled of oEquipoNombre to True
            WebSet pbEnabled of oBtnDespedir to False
            
        End
    
        Send SetActionButtons
    End_Procedure

End_Object 
